function findValueByKey(obj, companyName) { //функція з двома аргументами: обєкт в якому шукаємо і назву, яку шукаємо
    if (obj.name === companyName) { //перевірка: чи імя в цьому обєкті співпадає з тим що ми шукаємо? - так
        return obj; //ми знайшли компанію і повертаємо обєкт в якому знайшли
    }

    // перевірка клієнтів, якщо в першому випадку не знайшли, провалюємося глибше
    if (obj.clients){//якщо у обєкта є поле клієент
        for (let client of obj.clients) { // по передираємо циклом кожен обєкті в клієнті
            const res = findValueByKey(client, companyName); // хнову викликаємо нашу функцію, для кожного клієнта, так само як ми робили з головною компанією
            if (res) { // якщо знайшли - повертаємо обєкт з шуканою назвою
                return res;
            }
        }
    }

    // перевірка партнерів, якщо і в клієнтах не знайшли
    if (obj.partners) {
        for (let partner of obj.partners) {
            const res = findValueByKey(partner, companyName);
            if (res) {
                return res;
            }
        }
    }

    return null; // якщо нічого не знайдено
}

